# Reproducible build of the obfuscation-enabled netmaker server.
# Self-contained: builds inside alpine (musl) so the cgo sqlite binary matches
# the alpine runtime stage. No dependency on the upstream gravitl/go-builder.
FROM golang:1.26-alpine AS builder
RUN apk add --no-cache gcc musl-dev git
WORKDIR /app
COPY . .
RUN GOOS=linux CGO_ENABLED=1 go build -ldflags="-s -w" -o netmaker .

FROM alpine:3.23.4
WORKDIR /root/
RUN apk upgrade --no-cache && apk add --no-cache sqlite
RUN mkdir -p /etc/netclient/config
COPY --from=builder /app/netmaker .
COPY --from=builder /app/config config
EXPOSE 8081
EXPOSE 3478/udp
EXPOSE 3479/udp
ENTRYPOINT ["./netmaker"]
